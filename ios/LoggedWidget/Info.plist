<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	NSExtensionPrincipalClass is deliberately present, and Xcode's own Widget
	Extension template does NOT generate it.

	Without it, installing a sideloaded build fails at install time with
	AppexBundleMissingClassOrStoryboard: installd insists an appex declare either
	NSExtensionMainStoryboard or NSExtensionPrincipalClass, and a SwiftUI @main
	WidgetBundle declares neither. See Apple Developer Forums thread 734428 for
	the catch-22: adding the key fixes installation, and the only thing it breaks
	is App Store Connect upload, which rejects it as an unexpected key.

	Logged is local-only and is never submitted to the App Store, so that trade
	costs nothing here. WidgetKit launches the extension through its own entry
	point (the @main attribute), not by instantiating this class.

	BUT the value must still be RESOLVABLE by NSClassFromString. It first pointed
	at LoggedWidgetBundle, which is a SwiftUI *struct* and therefore has no
	Objective-C class metadata: installd was satisfied (it only checks that the
	key is present) so the app installed, yet the widget never appeared in the
	gallery, because resolving the principal class yielded nil and the extension
	could not be launched when WidgetKit probed it. It now points at a real
	NSObject subclass declared purely for this purpose in
	LoggedWidgetBundle.swift, named via @objc so this string does not depend on
	the module name.

	If this app is ever submitted to the App Store, this key must be removed.
-->
<plist version="1.0">
<dict>
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.widgetkit-extension</string>
		<key>NSExtensionPrincipalClass</key>
		<string>LoggedWidgetPrincipal</string>
	</dict>
</dict>
</plist>
